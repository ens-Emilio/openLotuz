# OpenLotuz — copie para .env e preencha (nunca commite o .env real)
# Supabase ( /opt/lotuz/crm/supabase/.env )
POSTGRES_PASSWORD=troque_aqui_32_chars
JWT_SECRET=troque_aqui_32_chars
ANON_KEY=troque_aqui
SERVICE_ROLE_KEY=troque_aqui
VAULT_ENC_KEY=troque_aqui_32_chars

# Backup R2 ( /opt/lotuz/.backup.env )
R2_BUCKET=seu-bucket-r2

# Hermes Agent ( /root/.hermes/.env )
HERMES_KODEO_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOW_ALL_USERS=false
ANON_KEY_HERMES=

# Serviços (scripts lotuz-* — ou exporte MKT_URL/SDR_URL/WA_URL)
MKT_URL=https://mkt.example.com
SDR_URL=https://sdr.example.com
WA_URL=https://wa.example.com
CRM_URL=https://crm.example.com

# Cloudflare Tunnel ( /etc/cloudflared/config.yaml — não versionar credenciais )
# TUNNEL_ID=SEU_TUNNEL_ID
# ZONE_ID=SEU_ZONE_ID
# ACCOUNT_ID=SEU_ACCOUNT_ID
